{
  "functions": {
    "index": {
      "includeFiles": "js/**, css/**, libs/**, image/**, *.html, *.js, *.mjs, *.json, *.txt, *.ico, *.png"
    }
  },
  "rewrites": [
    {
      "source": "/proxy/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/s=:query",
      "destination": "/index.html"
    },
    {
      "source": "/player.html",
      "destination": "/player.html"
    },
    {
      "source": "/player.html/:path*",
      "destination": "/player.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*"
    }
  ]
}
